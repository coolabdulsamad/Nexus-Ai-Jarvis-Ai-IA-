# Optional: change where Nexus stores its local SQLite database.
NEXUS_DB_PATH=./data/nexus.db

# Optional: only needed when the console and API use different origins.
# Leave empty during normal local development; Vite proxies /api automatically.
VITE_API_URL=

# Local Ollama inference. No API key is required for a local model.
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_OLLAMA_STATUS_TIMEOUT=3
NEXUS_OLLAMA_TIMEOUT=120

# Choose the model in Assistant settings; the default is qwen2.5:3b.
# Pull it with: ollama pull qwen2.5:3b
